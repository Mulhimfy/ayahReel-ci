<?xml version="1.0" encoding="utf-8"?>
<!-- Night over the picture: darker at the foot, where the translation
     sits, and never clear at the top. Strong enough that the brightest
     wide scenery (a sunlit coast) still carries gold script. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#C20B0C14"
        android:centerColor="#7A0B0C14"
        android:endColor="#5C0B0C14" />
</shape>
