<?xml version="1.0" encoding="utf-8"?>
<!-- The verse widget's one frame. Only views RemoteViews can inflate.

     The picture fills the frame and is centre-cropped, whatever the
     widget's shape; a scrim darkens it from the bottom so gold script
     and white translation read on the brightest scenery. The Arabic
     sits in the middle with the KFGQPC face as a font resource
     (Android 8+; older phones fall back to the system Arabic face) and
     auto-sizes down to fit its box. Everything has a default so the
     Android 12+ picker preview is a real frame, not empty boxes.

     Corners: the root clips to its rounded background on Android 12+
     (system_app_widget_background_radius, see values-v31/dimens.xml);
     clipToOutline is ignored below that and the frame is square. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wbg_00"
        android:contentDescription="@null" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="11dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_label"
                android:textColor="@color/widget_gold"
                android:textSize="9.5sp"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_ref"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/widget_preview_ref"
                android:textColor="@color/widget_muted"
                android:textSize="9.5sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_arabic"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textDirection="rtl"
            android:textAlignment="center"
            android:fontFamily="@font/uthmanic_hafs"
            android:text="@string/widget_preview_arabic"
            android:textColor="@color/widget_gold_bright"
            android:textSize="18sp"
            android:lineSpacingMultiplier="1.12"
            android:maxLines="3"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="0.5sp"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:shadowDy="1" />

        <TextView
            android:id="@+id/widget_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:text="@string/widget_preview_translation"
            android:textColor="@color/widget_text"
            android:textSize="10.5sp"
            android:textStyle="italic"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:shadowDy="1" />

        <!-- The maker's mark: the app's name, small and tracked, set
             under a hairline of gold at the foot — the way a page is
             signed, not a logo stamped on it. -->
        <!-- A FrameLayout, not a View: RemoteViews can only inflate
             the handful of classes it knows, and a plain View is not
             one of them - the whole widget comes up blank. -->
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="1px"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="3dp"
            android:background="#8CD4A947" />

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:text="@string/widget_brand"
            android:textColor="@color/widget_gold"
            android:textSize="7.5sp"
            android:letterSpacing="0.22"
            android:textStyle="bold"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:shadowDy="1" />
    </LinearLayout>
</FrameLayout>
